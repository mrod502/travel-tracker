
PGPORT=5432

#PGUSER=postgres
#DATABASE_URL=postgres://postgres:devpassword@localhost:7789/travel
DB_PASSWORD=devpassword
# Alternative: Use DATABASE_URL directly instead of above (comment out PG* vars if using this)
# DATABASE_URL=postgres://postgres:postgres@localhost:7789/travel

# Optional: the node id this node has to turn out to be — 64 hex characters, the
# SHA-256 of the signing key in BT_DATA_DIR (default ~/.btmon/data). It asserts an
# identity rather than choosing one, and only the monitor looks at it: `ca`, `query`
# and `stats` need no node id at all.
#
# It is NOT a UUID, which is what this line used to hold; a UUID fails startup. Use
# the value the node prints at startup as "Node ID: ..." (and that `ca ca-enroll`
# prints), or leave it unset to accept the key the machine already has.
# NODE_ID=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info