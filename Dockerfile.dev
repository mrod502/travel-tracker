# Dockerfile.dev
#
# Isolated dev container for running an LLM coding agent (e.g., qwen, claude-code)
# in sandboxed mode.
# Goals:
#   - non-root user, matched to host UID/GID so the bind-mounted workspace
#     doesn't end up with permission mismatches
#   - Rust toolchain + runtime dependencies
#   - read-only root fs at runtime (see compose.yaml), so everything the
#     container needs to write to (language caches, home, tmp) is either a
#     volume or tmpfs
#   - git + ssh-client present so cargo can pull
#     private modules over the mounted, read-only ~/.ssh and ~/.gitconfig
#   - zsh as the interactive shell
#
# Rust-specific:
#   - Base image: rust:1.97-bookworm
#   - System dependencies: pkg-config, libssl-dev (for many crates)
#   - Rust tools: rustfmt, clippy, rust-analyzer, cargo-watch
#   - Rust uses project-local target/, so no special cache volumes needed

FROM rust:1.97-bookworm

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

RUN apt-get update && apt-get install -y wget lsb-release gnupg && \
    sh -c 'echo "deb http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list' && \
    wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | apt-key add - && \
    apt-get update

# Install system dependencies (may need libs for specific crates)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        openssh-client \
        less \
        vim \
        zsh \
        pkg-config \
        libssl-dev \
        libdbus-1-dev \
        postgresql-client-18 \
        bluez \
        bluetooth \
        libbluetooth-dev

# Install nvm in a system location (not under /home/dev which is a volume)
ENV NVM_DIR=/opt/nvm

RUN mkdir -p /home/dev/.cargo

RUN mkdir -p $NVM_DIR \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install 24.13.1 \
    && nvm alias default 24.13.1 \
    && npm install -g @qwen-code/qwen-code@latest \
    && rm -rf "$NVM_DIR/.cache"

RUN apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Rust tools
RUN rustup component add rustfmt clippy rust-analyzer \
    && cargo install cargo-watch cargo-llvm-cov cargo-edit

# Non-root user setup
RUN groupadd --gid ${USER_GID} ${USERNAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/zsh ${USERNAME}

# Create workspace (target/ is project-local, no special dirs needed)
RUN mkdir -p /workspace \
    && chown -R ${USERNAME}:${USERNAME} /workspace

RUN git config --system --add safe.directory /workspace
RUN cargo install sqlx-cli

ENV GIT_TERMINAL_PROMPT=0

# A minimal system-wide zshrc. This lives on the image's (read-only at
# runtime) root fs rather than under $HOME, because $HOME (/home/dev) is
# a tmpfs/volume mount in compose.yaml.
RUN cat <<'EOF' > /etc/zsh/zshrc
HISTFILE="${HOME}/.history"
HISTSIZE=5000
SAVEHIST=5000
setopt SHARE_HISTORY
autoload -Uz compinit && compinit -C
PROMPT='%F{cyan}llm-dev%f:%F{blue}%~%f %# '

# nvm setup  
export NVM_DIR="/opt/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
EOF

# Runs as the dev user before exec-ing the real command. Its only job is
# to make sure $HOME has the files zsh expects, since tmpfs/volume
# gives us a fresh empty /home/dev on every container start.
RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/sh
set -e

# Create .zshrc that sources the system-wide config
cat > "$HOME/.zshrc" <<'ZSHRC'
# Source system-wide zshrc
source /etc/zsh/zshrc
ZSHRC

exec "$@"
EOF
RUN chmod +x /usr/local/bin/entrypoint.sh

USER ${USERNAME}
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/zsh"]
